# Required to unlock the private /inventory workspace.
# Use a unique password of at least 12 characters.
INVENTORY_ADMIN_PASSWORD=replace-with-a-strong-private-password

# Required to sign 12-hour inventory session cookies.
# Use a random value of at least 32 characters.
INVENTORY_SESSION_SECRET=replace-with-at-least-32-random-characters

# Required for trusted external POST /api/inventory-sync calls.
# Use a different random value of at least 32 characters.
AUTH_SECRET=replace-with-a-different-32-character-secret
